# Set to the header name your Okta proxy injects (e.g. X-Auth-Proxy-Username)
# Leave empty for local development
OKTA_HEADER=

# Dev login password (only works when OKTA_HEADER is empty)
ADMIN_PASSWORD=changeme

# Generate a long random string for production
SESSION_SECRET=dev-secret-change-in-production

# Database (Microsoft SQL Server)
# For the Azure SQL Database dev instance, DB_SERVER is the "Server" value
# from the connection string, e.g. training-portal.database.windows.net
# For production, IT will supply their own server address and credentials.
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
# Azure SQL Database requires this to stay true. Only set to false for a
# local/on-prem SQL Server with a properly trusted certificate.
DB_ENCRYPT=true
# Only set to true for local/on-prem SQL Server using a self-signed
# certificate (not needed for Azure SQL Database).
DB_TRUST_SERVER_CERT=false

# Email (leave empty to disable notifications during dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
